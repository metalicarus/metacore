<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Sem <parent> de propósito: importar este BOM não pode trazer junto o
    dependencyManagement do metacore-parent (bibliotecas de terceiros e de teste).
  -->
  <groupId>br.com.genosha</groupId>
  <artifactId>metacore-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>MetaCore BOM</name>
  <description>Alinha as versões dos módulos do MetaCore.</description>
  <url>https://genosha.com.br</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-format-image</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-format-pdf</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
