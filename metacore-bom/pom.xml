<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Sem <parent> de propósito: importar este BOM não pode trazer junto o
    dependencyManagement do metacore-parent (bibliotecas de terceiros e de teste).
  -->
  <groupId>br.com.genosha</groupId>
  <artifactId>metacore-bom</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>MetaCore BOM</name>
  <description>Alinha as versões dos módulos do MetaCore.</description>
  <url>https://github.com/metalicarus/metacore</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>metalicarus</id>
      <name>metalicarus</name>
      <url>https://github.com/metalicarus</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/metalicarus/metacore.git</connection>
    <developerConnection>scm:git:git@github.com:metalicarus/metacore.git</developerConnection>
    <url>https://github.com/metalicarus/metacore</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/metalicarus/metacore/issues</url>
  </issueManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-format-image</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-format-pdf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-format-office</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.genosha</groupId>
        <artifactId>metacore-isolation</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        Só para "mvn spotless:apply" funcionar na raiz: o Maven resolve o prefixo do
        plugin em cada módulo, e o BOM não herda do metacore-parent.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- O BOM não herda do metacore-parent: repete aqui o necessário para a publicação. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
