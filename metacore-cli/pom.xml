<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.genosha</groupId>
    <artifactId>metacore-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>metacore-cli</artifactId>
  <name>MetaCore CLI</name>
  <description>Ferramenta de linha de comando do MetaCore.</description>

  <properties>
    <module.name>br.com.genosha.metacore.cli</module.name>
    <!-- A CLI é distribuída com runtime próprio (ADR 0001). -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>A CLI compila com release 25. Em JDK 21, rode o build com -pl '!metacore-cli'.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-image</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-pdf</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
