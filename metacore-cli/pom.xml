<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.genosha</groupId>
    <artifactId>metacore-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>metacore-cli</artifactId>
  <name>MetaCore CLI</name>
  <description>Ferramenta de linha de comando do MetaCore.</description>

  <properties>
    <module.name>br.com.genosha.metacore.cli</module.name>
    <!-- A CLI é distribuída com runtime próprio (ADR 0001). -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Opções do jpackage específicas da plataforma; vazio no Linux. -->
    <dist.platform.options />
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>br.com.genosha.metacore.cli.MetacoreCli</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>A CLI compila com release 25. Em JDK 21, rode o build com -pl '!metacore-cli'.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Executável com runtime próprio (ADR 0011): mvn -Pdist package -pl metacore-cli -am
      Resultado em target/dist/metacore (bin/metacore). Exige o JDK 25 com jpackage.
    -->
    <profile>
      <id>dist</id>
      <properties>
        <!-- O jpackage só aceita versões numéricas: a versão do projeto sem o qualificador. -->
        <dist.version>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</dist.version>
        <!-- Calculado com jdeps; java.xml (XMP) e jdk.charsets (textos EXIF) entram explicitamente. -->
        <dist.modules>java.base,java.desktop,java.logging,java.naming,java.sql,java.xml,jdk.charsets</dist.modules>
        <dist.input>${project.build.directory}/jpackage-input</dist.input>
        <dist.output>${project.build.directory}/dist</dist.output>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-dist</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${dist.input}</directory>
                    </fileset>
                    <fileset>
                      <directory>${dist.output}</directory>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${build-helper-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>parse-version</id>
                <goals>
                  <goal>parse-version</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-runtime-dependencies</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${dist.input}/lib</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-main-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${dist.input}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${project.build.finalName}.jar</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <!--
                    commandlineArgs aceita aspas, inclusive com caminhos do Windows. O jlink não
                    remove os comandos nativos: o runtime precisa de bin/java para os workers da
                    análise isolada (ADR 0016).
                  -->
                  <commandlineArgs>--type app-image --name metacore --app-version ${dist.version} --vendor Genosha --input "${dist.input}" --main-jar ${project.build.finalName}.jar --main-class br.com.genosha.metacore.cli.MetacoreCli --add-modules ${dist.modules} --jlink-options "--strip-debug --no-header-files --no-man-pages --compress=zip-6" --app-content "${project.basedir}/../LICENSE,${project.basedir}/../NOTICE" --dest "${dist.output}" ${dist.platform.options}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- No Windows, o launcher precisa de console para uma ferramenta de linha de comando. -->
    <profile>
      <id>dist-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <dist.platform.options>--win-console</dist.platform.options>
      </properties>
    </profile>
    <!--
      No macOS, o jpackage recusa versões que começam com zero. O número vale só para o
      Info.plist do pacote; a CLI informa a própria versão a partir do JAR.
    -->
    <profile>
      <id>dist-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <dist.version>1.0.0</dist.version>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-image</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-pdf</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-office</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-isolation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Geradores de fixtures do módulo de imagem. -->
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-image</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-office</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
