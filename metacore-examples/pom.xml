<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.genosha</groupId>
    <artifactId>metacore-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>metacore-examples</artifactId>
  <name>MetaCore Examples</name>
  <description>Exemplos de integração. Não é publicado.</description>

  <properties>
    <module.name>br.com.genosha.metacore.examples</module.name>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Não publicado: dispensa fontes, javadoc e assinatura no perfil release. -->
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-image</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-pdf</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>br.com.genosha</groupId>
      <artifactId>metacore-format-image</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
